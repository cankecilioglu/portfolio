---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { CONTACT } from '../consts';
import portrait from '../assets/can-portrait.jpg';

const facts = [
  { label: 'Focus', value: 'Perception · sensor fusion · embedded systems' },
  { label: 'Stack', value: 'ROS2 · micro-ROS · C/C++ · ESP32 · Raspberry Pi · EKF' },
  { label: 'Now', value: 'Final year at TAÜ · open to robotics roles' },
];
---

<BaseLayout
  title="About"
  description="Can Keçilioğlu — final-year mechatronics engineer at the Turkish-German University, working on the perception, fusion and firmware that let robots act on sensor data."
>
  <section class="wrap page-head">
    <div class="reveal">
      <Eyebrow>About</Eyebrow>
      <h1 class="display-1 page-title">Robotics, from the sensor up.</h1>
    </div>
  </section>

  <section class="wrap about-body">
    <div class="about-copy reveal">
      <p>
        I&rsquo;m Can Keçilioğlu, a final-year mechatronics engineering student at the
        Turkish-German University (TAÜ). I work on the software and firmware that turn a robot&rsquo;s
        raw sensor data into decisions it can act on.
      </p>
      <p>
        My focus is perception, sensor fusion and embedded systems — the layer where a noisy reading
        on a microcontroller becomes a state estimate the rest of the stack can trust. I&rsquo;m most
        effective where hardware, firmware and higher-level software meet.
      </p>
      <p>
        I care about the unglamorous parts: clean timing, honest error handling and systems that hold
        up outside the demo. If that&rsquo;s the kind of engineering you value, we&rsquo;ll get along.
      </p>
    </div>

    <aside class="about-side reveal">
      <figure class="portrait">
        <Image src={portrait} alt="Can Keçilioğlu" width={760} class="portrait-img" />
      </figure>

      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts-row">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
        <div class="facts-row">
          <dt>Elsewhere</dt>
          <dd>
            <a href={CONTACT.github} target="_blank" rel="me noopener noreferrer"
              >{CONTACT.githubHandle}</a
            >
            <br />
            <a href={CONTACT.linkedin} target="_blank" rel="me noopener noreferrer">LinkedIn</a>
          </dd>
        </div>
      </dl>
    </aside>
  </section>
</BaseLayout>

<style>
  .about-body {
    padding-bottom: clamp(4rem, 2.5rem + 6vw, 7rem);
    margin-top: clamp(2rem, 1.4rem + 2.5vw, 3rem);
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 4rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .about-body { grid-template-columns: minmax(0, 1fr) 20rem; align-items: start; }
  }
  .about-copy {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: color-mix(in oklab, var(--fg) 88%, var(--muted));
    max-width: 62ch;
  }
  .about-copy > p + p { margin-top: 1.2em; }

  .about-side {
    display: grid;
    gap: 1.25rem;
  }
  .portrait {
    margin: 0;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
  }
  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    display: block;
  }

  .facts {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: var(--card);
    padding: 1.4rem;
    display: grid;
    gap: 1.05rem;
  }
  .facts-row {
    display: grid;
    gap: 0.3rem;
    padding-bottom: 1.05rem;
    border-bottom: 1px solid var(--line);
  }
  .facts-row:last-child { padding-bottom: 0; border-bottom: 0; }
  .facts-row dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .facts-row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--fg);
  }
  .facts-row dd a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
