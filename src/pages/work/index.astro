---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Work"
  description="Selected robotics, embedded and data projects by Can Keçilioğlu: a ground-analysis rover, a split-flap display and an EV telemetry study."
>
  <section class="wrap page-head">
    <div class="reveal">
      <Eyebrow>Work</Eyebrow>
      <h1 class="display-1 page-title">Selected work.</h1>
      <p class="lede page-intro">
        A few projects, in depth. Each one runs the full path, from raw sensor data to something a
        system can act on, with an honest account of what I owned and what I&rsquo;d change.
      </p>
    </div>
  </section>

  <section class="wrap work-section">
    <div class="work-grid reveal">
      {
        projects.map((p, i) => (
          <ProjectCard
            href={`/work/${p.id}`}
            title={p.data.title}
            summary={p.data.summary}
            stack={p.data.stack}
            status={p.data.status}
            index={String(i + 1).padStart(2, '0')}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .work-section {
    padding-bottom: clamp(4rem, 2.5rem + 6vw, 7rem);
  }
  .work-grid {
    margin-top: clamp(2.5rem, 1.5rem + 4vw, 4rem);
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .work-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
