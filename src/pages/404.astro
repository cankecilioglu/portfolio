---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
---

<BaseLayout title="Page not found" description="That page couldn't be found.">
  <section class="wrap nf">
    <p class="nf-code label label-accent">Error 404</p>
    <h1 class="display-1 nf-title">Page not found.</h1>
    <p class="lede nf-copy">
      This address didn&rsquo;t resolve to anything. Let&rsquo;s get you back to solid ground.
    </p>
    <div class="nf-cta">
      <ArrowLink href="/" variant="primary">Back home</ArrowLink>
      <ArrowLink href="/work" variant="ghost">See the work</ArrowLink>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(4rem, 3rem + 8vw, 9rem);
    max-width: 46rem;
  }
  .nf-title { margin-top: 1.25rem; }
  .nf-copy { margin-top: 1.25rem; }
  .nf-cta {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
</style>
