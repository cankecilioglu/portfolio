---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
---

<BaseLayout title="Signal lost" description="That page couldn't be found.">
  <section class="wrap nf">
    <p class="nf-code">404</p>
    <div class="nf-rule" aria-hidden="true"></div>
    <h1 class="display-2 nf-title">Signal lost.</h1>
    <p class="nf-copy">
      No reading at this address — the estimate didn't converge. Let's get you back to known ground.
    </p>
    <div class="nf-cta">
      <ArrowLink href="/" variant="primary">Back home</ArrowLink>
      <ArrowLink href="/work" variant="ghost">See the work</ArrowLink>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(4rem, 3rem + 8vw, 8rem);
    max-width: 44rem;
  }
  .nf-code {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.3em;
    color: var(--color-signal);
  }
  .nf-rule {
    margin: 1.25rem 0;
    height: 3px;
    width: 100%;
    max-width: 16rem;
    border-radius: 999px;
    background: var(--heat);
  }
  .nf-title {
    margin-bottom: 1rem;
  }
  .nf-copy {
    color: var(--color-muted);
    font-size: 1.0625rem;
    max-width: 48ch;
  }
  .nf-cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
</style>
