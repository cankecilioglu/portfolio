---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { CONTACT } from '../consts';

const methods = [
  { label: 'Email', value: CONTACT.email, href: `mailto:${CONTACT.email}` },
  { label: 'GitHub', value: CONTACT.githubHandle, href: CONTACT.github, external: true },
  { label: 'LinkedIn', value: 'in/can-kecilioglu', href: CONTACT.linkedin, external: true },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Can Keçilioğlu — open to robotics and embedded roles, internships, and collaboration."
>
  <section class="wrap page-head">
    <div class="reveal">
      <Eyebrow>Contact</Eyebrow>
      <h1 class="display-1 page-title">Let&rsquo;s talk.</h1>
      <p class="lede page-intro">
        Open to robotics and embedded roles, internships, and collaboration on interesting problems.
        The fastest way to reach me:
      </p>
    </div>
  </section>

  <section class="wrap contact-body">
    <ul class="methods reveal">
      {
        methods.map((m) => (
          <li>
            <a
              href={m.href}
              class="method"
              target={m.external ? '_blank' : undefined}
              rel={m.external ? 'me noopener noreferrer' : undefined}
            >
              <span class="method-label">{m.label}</span>
              <span class="method-value">{m.value}</span>
              <span class="method-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .contact-body {
    padding-bottom: clamp(4rem, 2.5rem + 6vw, 7rem);
    margin-top: clamp(2rem, 1.4rem + 3vw, 3.25rem);
  }
  .methods {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
    max-width: 46rem;
  }
  .method {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: var(--card);
    transition:
      transform 0.16s var(--ease-out-expo),
      border-color 0.16s ease;
  }
  .method:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--accent) 55%, var(--line));
  }
  .method-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    min-width: 5.5rem;
  }
  .method-value {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--fg);
    word-break: break-word;
  }
  .method-arrow {
    margin-left: auto;
    color: var(--accent);
    transition: transform 0.18s var(--ease-out-expo);
  }
  .method:hover .method-arrow { transform: translateX(4px); }
</style>
