---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { CONTACT } from '../consts';

const methods = [
  { label: 'EMAIL', value: CONTACT.email, href: `mailto:${CONTACT.email}` },
  { label: 'GITHUB', value: CONTACT.githubHandle, href: CONTACT.github, external: true },
  { label: 'LINKEDIN', value: 'in/can-kecilioglu', href: CONTACT.linkedin, external: true },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Can Keçilioğlu — open to robotics and embedded roles, and to good problems at the sensor / state / meaning seam."
>
  <section class="wrap page-head reveal">
    <Eyebrow>contact</Eyebrow>
    <h1 class="display-1 page-title">Let's talk.</h1>
    <p class="page-intro">
      Open to robotics and embedded roles, and to good problems at the sensor / state / meaning seam.
      Best way to reach me:
    </p>
  </section>

  <section class="wrap contact-body reveal">
    <ul class="methods">
      {
        methods.map((m) => (
          <li class="method">
            <a
              href={m.href}
              class="method-link"
              target={m.external ? '_blank' : undefined}
              rel={m.external ? 'me noopener noreferrer' : undefined}
            >
              <span class="method-label">{m.label}</span>
              <span class="method-value">{m.value}</span>
              <span class="method-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="contact-foot">
      A "Ground Truth" newsletter is coming — the rover article will be the first dispatch.
    </p>
  </section>
</BaseLayout>

<style>
  .contact-body {
    margin-top: clamp(2rem, 1.4rem + 3vw, 3.25rem);
  }
  .methods {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
    max-width: 44rem;
  }
  .method-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background-color: var(--color-surface);
    transition:
      transform 0.16s var(--ease-out-expo),
      border-color 0.16s ease,
      background-color 0.16s ease;
  }
  .method-link:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-data) 50%, var(--color-line));
    background-color: var(--color-surface-2);
  }
  .method-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    min-width: 5.5rem;
  }
  .method-value {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-text);
    word-break: break-word;
  }
  .method-arrow {
    margin-left: auto;
    color: var(--color-data);
    transition: transform 0.18s var(--ease-out-expo);
  }
  .method-link:hover .method-arrow {
    transform: translateX(4px);
  }

  .contact-foot {
    margin-top: 2rem;
    max-width: 44rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
</style>
