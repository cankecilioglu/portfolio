---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Writing"
  description="Ground Truth — notes from the sensor / state / meaning seam by Can Keçilioğlu. First dispatch: the rover deep-dive."
>
  <section class="wrap page-head reveal">
    <Eyebrow>writing</Eyebrow>
    <h1 class="display-1 page-title">Ground Truth.</h1>
    <p class="page-intro">
      Notes from the part of robotics that's usually invisible — how a system perceives, what it
      trusts, and where it quietly breaks.
    </p>
  </section>

  <section class="wrap writing-body reveal">
    {
      posts.length === 0 ? (
        <div class="empty">
          <span class="empty-rule" aria-hidden="true" />
          <p class="empty-status">// no dispatches yet</p>
          <p class="empty-copy">
            The first post will be the rover deep-dive — the full path from a raw IMU reading to a
            live slope/roughness heatmap. Until then, the case study lives in{' '}
            <a href="/work/rover">Work</a>.
          </p>
        </div>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post">
              <a href={`/writing/${post.id}`} class="post-link">
                <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .writing-body {
    margin-top: clamp(2rem, 1.4rem + 3vw, 3.25rem);
  }

  .empty {
    position: relative;
    max-width: 46rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background-color: var(--color-surface);
    padding: clamp(1.5rem, 1.1rem + 2vw, 2.5rem);
    overflow: hidden;
  }
  .empty-rule {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--heat);
  }
  .empty-status {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-data);
  }
  .empty-copy {
    margin-top: 0.75rem;
    color: var(--color-muted);
    line-height: 1.7;
  }
  .empty-copy a {
    color: var(--color-data);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .post-link {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .post-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-text);
  }
  .post-desc {
    color: var(--color-muted);
  }
  .post-link:hover .post-title {
    color: var(--color-data);
  }
</style>
