---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Writing"
  description="Notes on robotics, perception and embedded systems by Can Keçilioğlu."
>
  <section class="wrap page-head">
    <div class="reveal">
      <Eyebrow>Writing</Eyebrow>
      <h1 class="display-1 page-title">Notes &amp; write-ups.</h1>
      <p class="lede page-intro">
        Occasional writing on the parts of robotics that don&rsquo;t make the highlight reel: how
        systems perceive, what they trust, and where they break.
      </p>
    </div>
  </section>

  <section class="wrap writing-body">
    {
      posts.length === 0 ? (
        <div class="empty reveal">
          <p class="empty-status label label-accent">No posts yet</p>
          <p class="empty-copy">
            First up: a write-up of the ground-analysis rover, the full path from a raw IMU reading
            to a live slope/roughness map. Until then, the case study lives in{' '}
            <a href="/work/rover">Work</a>.
          </p>
        </div>
      ) : (
        <ul class="post-list reveal">
          {posts.map((post) => (
            <li>
              <a href={`/writing/${post.id}`} class="post-link">
                <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .writing-body {
    padding-bottom: clamp(4rem, 2.5rem + 6vw, 7rem);
    margin-top: clamp(2rem, 1.4rem + 3vw, 3.25rem);
  }
  .empty {
    max-width: 46rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: var(--card);
    padding: clamp(1.5rem, 1.1rem + 2vw, 2.5rem);
  }
  .empty-copy {
    margin-top: 0.75rem;
    color: var(--muted);
    line-height: 1.7;
  }
  .empty-copy a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .post-link {
    display: grid;
    gap: 0.3rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .post-title {
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .post-desc { color: var(--muted); }
  .post-link:hover .post-title { color: var(--accent); }
</style>
