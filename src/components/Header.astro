---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="wordmark" aria-label={`${SITE.name}, home`}>
      <span class="wordmark-mark" aria-hidden="true"></span>
      <span class="wordmark-text">{SITE.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in oklab, var(--color-ink) 78%, transparent);
    backdrop-filter: blur(12px) saturate(120%);
    -webkit-backdrop-filter: blur(12px) saturate(120%);
    border-bottom: 1px solid var(--color-line-d);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    min-height: 4.25rem;
    padding-block: 0.7rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-size: 1.05rem;
    color: var(--color-text);
    transition: opacity 0.15s ease;
  }
  .wordmark:hover { opacity: 0.8; }
  .wordmark-mark {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 3px;
    background: var(--color-orange);
    box-shadow: 0 0 14px -2px color-mix(in oklab, var(--color-orange) 75%, transparent);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2.5vw, 1.9rem);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted-d);
    padding-block: 0.35rem;
    transition: color 0.15s ease;
  }
  .nav-link:hover { color: var(--color-text); }
  .nav-link[aria-current='page'] { color: var(--color-orange); }

  @media (max-width: 540px) {
    nav[aria-label='Primary'] { flex-basis: 100%; }
    .nav-list { justify-content: flex-start; }
  }
</style>
