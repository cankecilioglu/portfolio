---
import Badge from './Badge.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  stack?: string[];
  status?: 'flagship' | 'in-progress' | 'archived';
  index?: string;
}
const { href, title, summary, stack = [], status = 'flagship', index } = Astro.props;
const statusLabel =
  status === 'in-progress' ? 'In progress' : status === 'archived' ? 'Archived' : 'Flagship';
---

<a href={href} class="card card-hover project">
  <div class="project-head">
    {index && <span class="project-index label">{index}</span>}
    <Badge>{statusLabel}</Badge>
  </div>

  <h3 class="project-title">{title}</h3>
  <p class="project-summary">{summary}</p>

  {
    stack.length > 0 && (
      <ul class="project-stack">
        {stack.slice(0, 6).map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    )
  }

  <span class="project-cta" aria-hidden="true">
    View project <span class="arrow">&rarr;</span>
  </span>
</a>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
    padding: 1.6rem;
  }
  .project-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .project-index {
    color: var(--muted);
  }
  .project-title {
    font-size: 1.55rem;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--fg);
  }
  .project-summary {
    color: var(--muted);
    font-size: 0.975rem;
    line-height: 1.6;
  }
  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.1rem 0 0;
    padding: 0;
  }
  .project-stack li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--muted);
    padding: 0.22rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .project-cta {
    margin-top: auto;
    padding-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .project:hover .project-cta .arrow {
    transform: translateX(4px);
  }
  .project-cta .arrow {
    transition: transform 0.18s var(--ease-out-expo);
  }
</style>
