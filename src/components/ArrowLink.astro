---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  class?: string;
  external?: boolean;
  arrow?: boolean;
}
const {
  href,
  variant = 'primary',
  class: className = '',
  external = false,
  arrow = true,
} = Astro.props;
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a href={href} class:list={['btn', `btn-${variant}`, className]} rel={rel} target={target}>
  <span class="btn-label"><slot /></span>
  {arrow && <span class="arrow" aria-hidden="true">&rarr;</span>}
</a>
