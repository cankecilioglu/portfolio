---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<p class:list={['label eyebrow', className]}>
  <span class="eyebrow-tick" aria-hidden="true"></span>
  <slot />
</p>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .eyebrow-tick {
    width: 1.5rem;
    height: 2px;
    background: var(--accent);
    flex: none;
  }
</style>
