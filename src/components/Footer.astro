---
import { SITE, CONTACT } from '../consts';

const year = new Date().getFullYear();

const links = [
  { label: 'GitHub', href: CONTACT.github, external: true },
  { label: CONTACT.linkedinLabel, href: CONTACT.linkedin, external: true },
  { label: 'Email', href: `mailto:${CONTACT.email}`, external: false },
];
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-left">
      <a href="/" class="footer-word">
        <span class="footer-mark" aria-hidden="true"></span>
        {SITE.name}
      </a>
      <p class="footer-tag">{SITE.role}.</p>
    </div>

    <nav class="footer-links" aria-label="Social and contact">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="footer-link"
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'me noopener noreferrer' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <p class="footer-copy">&copy; {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line-d);
    background-color: #0b0a09;
  }
  .footer-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    padding-block: 3rem;
  }
  .footer-word {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-size: 1.05rem;
    color: var(--color-text);
  }
  .footer-mark {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
    background: var(--color-orange);
  }
  .footer-tag {
    margin-top: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--color-muted-d);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
  }
  .footer-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted-d);
    transition: color 0.15s ease;
  }
  .footer-link:hover { color: var(--color-orange); }
  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: color-mix(in oklab, var(--color-muted-d) 70%, transparent);
  }
</style>
