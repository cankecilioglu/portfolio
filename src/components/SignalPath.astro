---
/**
 * The signature element. The thesis, rendered as a telemetry pipeline:
 *   sensor → state → meaning
 * A thin heat-gradient rule runs beneath; a single signal pulse travels it once
 * on load (gated behind prefers-reduced-motion). Zero JS.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const stages = [
  { n: '01', name: 'SENSOR', caption: 'firmware · IMU/GPS', tone: 'sensor' },
  { n: '02', name: 'STATE', caption: 'sensor fusion · EKF', tone: 'state' },
  { n: '03', name: 'MEANING', caption: 'mapping · world model', tone: 'meaning' },
];

// Interleave stages with arrows so each map iteration returns a single node.
type Item =
  | { kind: 'stage'; n: string; name: string; caption: string; tone: string }
  | { kind: 'arrow' };
const items: Item[] = [];
stages.forEach((s, i) => {
  items.push({ kind: 'stage', ...s });
  if (i < stages.length - 1) items.push({ kind: 'arrow' });
});
---

<figure class:list={['signal-path', className]} aria-label="Signal path: sensor to state to meaning">
  <ol class="stages">
    {
      items.map((it) =>
        it.kind === 'arrow' ? (
          <li class="arrow" aria-hidden="true">&rarr;</li>
        ) : (
          <li class="stage" data-tone={it.tone}>
            <span class="stage-num">{it.n}</span>
            <span class="stage-name">{it.name}</span>
            <span class="stage-caption">{it.caption}</span>
          </li>
        )
      )
    }
  </ol>
  <div class="heat-rule" aria-hidden="true">
    <span class="pulse"></span>
  </div>
</figure>

<style>
  .signal-path {
    margin: 0;
    width: 100%;
  }

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .stage {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .stage-num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }
  .stage[data-tone='sensor'] .stage-num {
    color: var(--color-data);
  }
  .stage[data-tone='meaning'] .stage-num {
    color: var(--color-signal);
  }
  .stage-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    color: var(--color-text);
  }
  .stage-caption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .arrow {
    display: none;
    align-self: center;
    color: color-mix(in oklab, var(--color-muted) 70%, transparent);
    font-size: 1.1rem;
  }

  .heat-rule {
    position: relative;
    container-type: inline-size;
    margin-top: 1.6rem;
    height: 3px;
    border-radius: 999px;
    background: var(--heat);
    overflow: hidden;
  }

  .pulse {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 88px;
    transform: translateX(-100px);
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, var(--color-text) 92%, white) 50%,
      transparent
    );
  }

  /* >= 640px: become the horizontal pipeline with arrows between stages. */
  @media (min-width: 640px) {
    .stages {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: start;
      gap: 1rem;
    }
    .arrow {
      display: block;
    }
  }

  /* The one orchestrated moment — a single pulse, once, on load. */
  @media (prefers-reduced-motion: no-preference) {
    .pulse {
      animation: pulse-travel 2.6s var(--ease-out-expo) 0.4s 1 both;
    }
  }

  @keyframes pulse-travel {
    0% {
      transform: translateX(-100px);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      transform: translateX(100cqw);
      opacity: 0;
    }
  }
</style>
