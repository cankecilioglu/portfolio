---
/**
 * A telemetry-styled media frame. Used inside project MDX as an on-brand
 * placeholder for assets that aren't in yet (heatmap clip, architecture
 * diagram, RViz capture). Swap the inner box for an <img>/<video> later.
 */
interface Props {
  kind?: string;
  caption?: string;
  ratio?: string;
  accent?: 'data' | 'signal';
}
const { kind = 'media', caption, ratio = '16 / 9', accent = 'data' } = Astro.props;
---

<figure class="media-frame" data-accent={accent}>
  <div class="media-box" style={`aspect-ratio:${ratio}`}>
    <span class="media-corner tl" aria-hidden="true"></span>
    <span class="media-corner tr" aria-hidden="true"></span>
    <span class="media-corner bl" aria-hidden="true"></span>
    <span class="media-corner br" aria-hidden="true"></span>
    <span class="media-kind">{kind}</span>
    <span class="media-hint">asset placeholder</span>
  </div>
  {caption && <figcaption class="media-cap">{caption}</figcaption>}
</figure>

<style>
  .media-frame {
    margin: 2rem 0;
  }
  .media-box {
    position: relative;
    display: grid;
    place-content: center;
    gap: 0.4rem;
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background-color: color-mix(in oklab, var(--color-surface) 60%, var(--color-ink));
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--color-line) 50%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--color-line) 50%, transparent) 1px, transparent 1px);
    background-size: 32px 32px;
    text-align: center;
    overflow: hidden;
  }
  .media-kind {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-data);
  }
  .media-frame[data-accent='signal'] .media-kind {
    color: var(--color-signal);
  }
  .media-hint {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-muted) 75%, transparent);
  }

  .media-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1px solid color-mix(in oklab, var(--color-muted) 60%, transparent);
  }
  .media-corner.tl {
    top: 10px;
    left: 10px;
    border-right: 0;
    border-bottom: 0;
  }
  .media-corner.tr {
    top: 10px;
    right: 10px;
    border-left: 0;
    border-bottom: 0;
  }
  .media-corner.bl {
    bottom: 10px;
    left: 10px;
    border-right: 0;
    border-top: 0;
  }
  .media-corner.br {
    bottom: 10px;
    right: 10px;
    border-left: 0;
    border-top: 0;
  }

  .media-cap {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
</style>
