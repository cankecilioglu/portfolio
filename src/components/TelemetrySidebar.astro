---
interface Spec {
  label: string;
  value: string;
  href?: string;
}
interface Props {
  specs: Spec[];
  class?: string;
}
const { specs, class: className = '' } = Astro.props;
---

<aside class:list={['telemetry', className]} aria-label="Project telemetry">
  <p class="telemetry-head">
    <span class="dot" aria-hidden="true"></span>
    telemetry
  </p>
  <dl class="telemetry-list">
    {
      specs.map((s) => (
        <div class="telemetry-row">
          <dt>{s.label}</dt>
          <dd>
            {s.href ? (
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.value}
              </a>
            ) : (
              s.value
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</aside>

<style>
  .telemetry {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background-color: color-mix(in oklab, var(--color-surface) 70%, var(--color-ink));
    padding: 1.25rem;
  }

  .telemetry-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-data);
    box-shadow: 0 0 8px -1px var(--color-data);
  }

  .telemetry-list {
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  .telemetry-row {
    display: grid;
    gap: 0.2rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--color-line);
  }
  .telemetry-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .telemetry-row dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .telemetry-row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-text);
    word-break: break-word;
  }
  .telemetry-row dd a {
    color: var(--color-data);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-data) 40%, transparent);
    text-underline-offset: 3px;
  }
  .telemetry-row dd a:hover {
    text-decoration-color: var(--color-data);
  }
</style>
