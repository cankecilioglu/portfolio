---
interface Spec {
  label: string;
  value: string;
  href?: string;
}
interface Props {
  specs: Spec[];
  class?: string;
}
const { specs, class: className = '' } = Astro.props;
---

<aside class:list={['telemetry', className]} aria-label="Project details">
  <p class="telemetry-head">
    <span class="dot" aria-hidden="true"></span>
    Details
  </p>
  <dl class="telemetry-list">
    {
      specs.map((s) => (
        <div class="telemetry-row">
          <dt>{s.label}</dt>
          <dd>
            {s.href ? (
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.value}
              </a>
            ) : (
              s.value
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</aside>

<style>
  .telemetry {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: var(--card);
    padding: 1.35rem;
  }
  .telemetry-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--accent);
  }
  .telemetry-list {
    margin: 0;
    display: grid;
    gap: 0.95rem;
  }
  .telemetry-row {
    display: grid;
    gap: 0.25rem;
    padding-bottom: 0.95rem;
    border-bottom: 1px solid var(--line);
  }
  .telemetry-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .telemetry-row dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .telemetry-row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--fg);
    word-break: break-word;
  }
  .telemetry-row dd a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
  }
  .telemetry-row dd a:hover {
    text-decoration-color: var(--accent);
  }
</style>
