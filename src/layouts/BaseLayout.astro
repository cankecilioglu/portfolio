---
import '../styles/global.css';

// Main typeface is Helvetica (system stack, no download). Only the monospace
// used for labels / code blocks is self-hosted.
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const { title, description, image, article } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} article={article} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--color-orange);
    color: #fff;
    padding: 0.5rem 0.9rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    transition: top 0.18s ease;
  }
  .skip-link:focus-visible {
    top: 1rem;
  }
</style>
